generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  CLIENTE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  name          String?
  role          Role       @default(CLIENTE)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  description  String?
  priceCents   Int?
  status       ProductStatus       @default(DRAFT)
  categoryId   String?
  collectionId String?
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collection   Collection?         @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  measurement  ProductMeasurement?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  storageKey String?
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String
  color     String
  colorHex  String?
  available Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId, available])
  @@index([available, productId])
}

model ProductMeasurement {
  id        String   @id @default(cuid())
  productId String   @unique
  bustCm    Decimal? @db.Decimal(5, 2)
  waistCm   Decimal? @db.Decimal(5, 2)
  hipCm     Decimal? @db.Decimal(5, 2)
  lengthCm  Decimal? @db.Decimal(5, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  anonymousId String
  productId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonymousId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
}

model VirtualFittingOperation {
  id                String   @id @default(cuid())
  requestId         String   @unique
  ownerHash         String
  productId         String
  variantId         String
  consentVersion    String
  status            String   @default("RESERVED")
  providerRequestId String?
  errorCode         String?
  reservedCredits   Int
  actualCredits     Int?
  settledAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime

  @@index([createdAt])
  @@index([ownerHash, createdAt])
  @@index([settledAt])
  @@index([expiresAt])
}

// Durable cleanup instructions, committed with metadata deletion. No personal images.
model StorageDeletionTask {
  id            String   @id @default(cuid())
  storageKey    String   @unique
  driver        String
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken    String?
  completedAt   DateTime?
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([driver, completedAt, nextAttemptAt])
}
