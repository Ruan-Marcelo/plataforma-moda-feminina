{
  "name": "plataforma-moda-feminina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma auth.ts tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run db:generate && npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "audit:browser": "node --env-file=.env scripts/audit-browser.cjs",
    "audit:performance": "node --env-file=.env scripts/audit-performance.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:provision-admin": "node --env-file=.env --import tsx prisma/provision-admin.ts",
    "db:purge-fitting-operations": "node --env-file=.env --import tsx prisma/purge-fitting-operations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "web-vitals": "6.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "eslint-config-next": {
      "@typescript-eslint/parser": "8.72.2",
      "@typescript-eslint/eslint-plugin": "8.72.2"
    }
  }
}
